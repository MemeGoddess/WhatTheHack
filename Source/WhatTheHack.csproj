<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>WhatTheHack</AssemblyName>
        <Version>1.7</Version>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <TargetFramework>net10.0</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <LangVersion>latest</LangVersion>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>..\$(Version)\Assemblies</OutputPath>
        <DefineConstants>TRACE;NDEBUG</DefineConstants>
        <WarningLevel>4</WarningLevel>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>Embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>..\$(Version)\Assemblies</OutputPath>
        <DefineConstants>TRACE;DEBUG;NETFRAMEWORK;NET48;</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*-*"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Lib.Harmony" ExcludeAssets="runtime">
            <Version>2.4.2</Version>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Publicize Include="Assembly-CSharp;UnityEngine.IMGUIModule;UnityEngine.CoreModule"/>
    </ItemGroup>
</Project>